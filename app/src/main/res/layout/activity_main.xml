<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕌 المنارة"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- بانر التحديث -->
        <LinearLayout
            android:id="@+id/updateBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/accent"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/updateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#000000"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUpdateNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تحديث الآن" />

        </LinearLayout>

        <!-- ===== قسم: المواقيت ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ مواقيت الصلاة"
            android:textColor="@color/accent"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnEnableLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 تفعيل مواقيت الصلاة (أول مرة)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBatteryOptimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔋 استثناء التطبيق من توفير الطاقة (يحسّن موثوقية المنبهات)"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/timesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- ===== قسم: صلِّ على النبي ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📿 تذكير صلِّ على النبي"
            android:textColor="@color/accent"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginBottom="24dp">

            <CheckBox
                android:id="@+id/salawatEnabledCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تفعيل التذكير"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/salawatStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="كل"
                    android:textColor="#FFFFFF" />

                <EditText
                    android:id="@+id/salawatIntervalInput"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="دقيقة"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnSaveSalawatInterval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="حفظ" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== قسم: المهمات ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ مهمات اليوم"
            android:textColor="@color/accent"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/tasksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/newTaskInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="أضف مهمة خاصة بك"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnAddTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إضافة" />

        </LinearLayout>

        <!-- ===== قسم: أدوات ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧭 أدوات"
            android:textColor="@color/accent"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnQibla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧭 بوصلة اتجاه القبلة"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnQuranQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖 اختبار حفظ القرآن (تسميع بالمايك)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnQAGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❓ دليل أسئلة وأجوبة"
            android:layout_marginBottom="24dp" />

        <!-- ===== قسم: التطبيق ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 التطبيق"
            android:textColor="@color/accent"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnShareApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 مشاركة ملف التطبيق"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 اقتراحات وتحديثات (واتساب)" />

    </LinearLayout>

</ScrollView>
